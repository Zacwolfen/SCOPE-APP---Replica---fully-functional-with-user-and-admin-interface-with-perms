@Composable
fun ExamDetailsScreen(store: LocalStore) {
    var exams by remember { mutableStateOf(store.exams()) }
    var edit by remember { mutableStateOf<Int?>(null) }
    val semesters = listOf("Semester: 1" to staticExams.getValue("Semester: 1"), "Semester: 2" to staticExams.getValue("Semester: 2"), "Semester: 3" to staticExams.getValue("Semester: 3"), "Semester: 4" to exams)
    val expanded = remember { mutableStateMapOf<String, Boolean>() }
    val weights = listOf(1f, 2f, 0.65f, 0.65f)
    LazyColumn {
        semesters.forEach { (s, list) ->
            item {
                Row(Modifier.fillMaxWidth().clickable { expanded[s] = !(expanded[s] ?: (s == "Semester: 4")) }.padding(horizontal = 18.dp, vertical = 12.dp), verticalAlignment = Alignment.CenterVertically) {
                    Text(s, color = BrightBlue, fontSize = 17.sp, fontWeight = FontWeight.Bold, modifier = Modifier.weight(1f))
                    Text(examMonths[s] ?: "", color = BrightBlue, fontSize = 17.sp, fontWeight = FontWeight.Bold)
                    Spacer(Modifier.width(6.dp))
                    Icon(if (expanded[s] ?: (s == "Semester: 4")) Icons.Default.KeyboardArrowUp else Icons.Default.KeyboardArrowDown, null, tint = Color.Black)
                }
                Divider(color = Border)
            }
            if ((expanded[s] ?: (s == "Semester: 4")) && list.isNotEmpty()) {
                item { GridTableHeader(listOf("Code", "Description", "Grade", "Result"), weights) }
                items(list) { e ->
                    val i = exams.indexOf(e)
                    val editable = s == "Semester: 4"
                    Row(Modifier.fillMaxWidth().clickable(enabled = editable) { edit = i }.background(if (list.indexOf(e) % 2 == 0) Color.White else RowGray).border(0.5.dp, Border)) {
                        Text(e.code, fontSize = 12.sp, modifier = Modifier.weight(weights[0]).border(0.5.dp, Border).padding(6.dp))
                        Text(e.description, fontSize = 12.sp, modifier = Modifier.weight(weights[1]).border(0.5.dp, Border).padding(6.dp))
                        Text(e.grade, fontSize = 13.sp, modifier = Modifier.weight(weights[2]).border(0.5.dp, Border).padding(6.dp), textAlign = TextAlign.Center)
                        Text(e.result, fontSize = 13.sp, modifier = Modifier.weight(weights[3]).border(0.5.dp, Border).padding(6.dp), textAlign = TextAlign.Center)
                    }
                }
            }
        }
    }
    if (edit != null) GradeDialog(exams[edit!!]) { g -> store.updateGrade(edit!!, g); exams = store.exams(); edit = null }
}
@Composable fun GradeDialog(e:Exam,onSave:(String)->Unit){var g by remember{mutableStateOf(e.grade)};AlertDialog(onDismissRequest={},title={Text("Edit Grade")},text={OutlinedTextField(g,{g=it},label={Text("Grade")})},confirmButton={TextButton(onClick={onSave(g)}){Text("SAVE")}},dismissButton={})}

private data class TTCell(val subject: String, val room: String)
private val timetableSlots = listOf("09:00-09:50", "09:50-10:40", "11:00-11:50", "11:50-12:40", "01:30-02:20", "02:20-03:10")
private val timetableData = listOf(
    "MON" to listOf(TTCell("FLAT", "301"), TTCell("CN", "301"), TTCell("ML", "LAB1"), TTCell("ML", "LAB1"), TTCell("FSWD", "204"), TTCell("-", "")),
    "TUE" to listOf(TTCell("DM", "301"), TTCell("FSWD", "301"), TTCell("IoD", "204"), TTCell("CN", "204"), TTCell("CC", "-"), TTCell("-", "")),
    "WED" to listOf(TTCell("CN", "301"), TTCell("IAF", "301"), TTCell("ML", "LAB1"), TTCell("ML", "LAB1"), TTCell("DM", "204"), TTCell("-", "")),
    "THU" to listOf(TTCell("FSWD", "301"), TTCell("DM", "301"), TTCell("FLAT", "204"), TTCell("IoD", "204"), TTCell("CN", "204"), TTCell("-", "")),
    "FRI" to listOf(TTCell("IoD", "301"), TTCell("CN", "301"), TTCell("DM", "204"), TTCell("FLAT", "204"), TTCell("IAF", "204"), TTCell("-", ""))
)
private val timetableLegend = listOf(
    "FLAT" to "FORMAL LANGUAGE AND AUTOMATA", "CN" to "COMPUTER NETWORKS", "ML" to "MACHINE LEARNING",
    "FSWD" to "FULL STACK WEB DEVELOPMENT", "DM" to "DISCRETE MATHEMATICS", "IoD" to "INTRODUCTION TO DRONES",
    "IAF" to "INDIAN ART FORM", "CC" to "COMMUNITY CONNECT"
)

@Composable
fun TimetableScreen() {
    val dayColWidth = 54.dp
    val slotColWidth = 96.dp
    Column(Modifier.fillMaxSize()) {
        Row(Modifier.weight(1f)) {
            Column(Modifier.width(dayColWidth)) {
                Box(Modifier.height(52.dp).fillMaxWidth().background(Red).border(0.5.dp, Border), contentAlignment = Alignment.Center) { Text("Day", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 13.sp) }
                timetableData.forEachIndexed { i, (day, _) ->
                    Box(Modifier.height(72.dp).fillMaxWidth().background(if (i % 2 == 0) Color.White else RowGray).border(0.5.dp, Border), contentAlignment = Alignment.Center) {
                        Text(day, fontWeight = FontWeight.Bold, color = BrightBlue, fontSize = 13.sp)
                    }
                }
            }
            Column(Modifier.weight(1f).horizontalScroll(rememberScrollState())) {
                Row {
                    timetableSlots.forEach { slot ->
                        Box(Modifier.width(slotColWidth).height(52.dp).background(Red).border(0.5.dp, Border), contentAlignment = Alignment.Center) {
                            Text(slot, color = Color.White, fontWeight = FontWeight.Bold, fontSize = 11.sp, textAlign = TextAlign.Center)
                        }
                    }
                }
                timetableData.forEachIndexed { i, (_, cells) ->
                    Row {
                        cells.forEach { cell ->
                            Box(Modifier.width(slotColWidth).height(72.dp).background(if (i % 2 == 0) Color.White else RowGray).border(0.5.dp, Border).padding(4.dp), contentAlignment = Alignment.Center) {
                                if (cell.subject != "-") Column(horizontalAlignment = Alignment.CenterHorizontally) {
                                    Text(cell.subject, fontSize = 13.sp, fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
                                    Text(cell.room, fontSize = 10.sp, color = Color.Gray)
                                } else Text("-", color = Color.LightGray)
                            }
                        }
                    }
                }
            }
        }
        Column(Modifier.background(PageGray).padding(14.dp)) {
            Text("LEGEND:", color = BrightBlue, fontWeight = FontWeight.Bold, fontSize = 15.sp)
            timetableLegend.forEach { (code, name) -> Text("$code - $name", fontSize = 11.sp, lineHeight = 16.sp) }
        }
    }
}
@Composable fun UnavailableScreen(message: String) { Box(Modifier.fillMaxSize().padding(top = 260.dp, start = 22.dp, end = 22.dp)) { Text(message, fontSize = 18.sp, textAlign = TextAlign.Start) } }
@Composable fun TablePage(headers:List<String>, rows:List<List<String>>){Column(Modifier.fillMaxSize()){TableHeader(headers,headers.map{1f/headers.size});LazyColumn{items(rows){r->TableRow(r,headers.map{1f/headers.size})}}}}
