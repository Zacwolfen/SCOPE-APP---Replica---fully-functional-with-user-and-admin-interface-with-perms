@Composable
fun AttendanceScreen(store: LocalStore) {
    val rows = remember { store.attendance() }

    val overallConducted = rows.sumOf { it.conducted }
    val overallPresent = rows.sumOf { it.attended }
    val overall =
        if (overallConducted == 0) 0.0
        else overallPresent * 100.0 / overallConducted

    Column(Modifier.fillMaxSize()) {
        Row(
            Modifier
                .fillMaxWidth()
                .background(Red)
                .padding(vertical = 12.dp)
        ) {
            listOf("Code", "TH", "PH", "AH", "%").forEachIndexed { i, h ->
                Text(
                    h,
                    color = Color.White,
                    fontWeight = FontWeight.Bold,
                    fontSize = 16.sp,
                    textAlign = TextAlign.Center,
                    modifier = Modifier.weight(if (i == 0) 2.2f else 1f)
                )
            }
        }

        LazyColumn(Modifier.weight(1f)) {
            itemsIndexed(rows) { i, a ->
                Row(
                    Modifier
                        .fillMaxWidth()
                        .background(if (i % 2 == 0) Color.White else RowGray)
                        .padding(vertical = 15.dp)
                ) {
                    Text(
                        a.code,
                        fontSize = 14.sp,
                        modifier = Modifier.weight(2.2f),
                        textAlign = TextAlign.Center
                    )

                    Text(
                        a.conducted.toString(),
                        fontSize = 15.sp,
                        modifier = Modifier.weight(1f),
                        textAlign = TextAlign.Center
                    )

                    Text(
                        a.attended.toString(),
                        fontSize = 15.sp,
                        modifier = Modifier.weight(1f),
                        textAlign = TextAlign.Center
                    )

                    Text(
                        a.absent.toString(),
                        fontSize = 15.sp,
                        modifier = Modifier.weight(1f),
                        textAlign = TextAlign.Center
                    )

                    Text(
                        String.format(Locale.US, "%.2f %%", a.percentage),
                        fontSize = 14.sp,
                        modifier = Modifier.weight(1f),
                        textAlign = TextAlign.Center
                    )
                }
            }

            item {
                Spacer(Modifier.height(14.dp))

                Text(
                    "Overall Attendance: ${
                        String.format(Locale.US, "%.2f%%", overall)
                    }",
                    color = BrightBlue,
                    fontSize = 20.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(horizontal = 18.dp)
                )

                Spacer(Modifier.height(10.dp))
                LegendAttendance()

                Column(
                    Modifier.padding(
                        horizontal = 18.dp,
                        vertical = 4.dp
                    )
                ) {
                    rows.forEach { a ->
                        Text(
                            buildAnnotatedCodeName(a.code, a.name),
                            fontSize = 15.sp,
                            lineHeight = 24.sp
                        )
                    }
                }

                Spacer(Modifier.height(14.dp))
            }
        }
    }
}

