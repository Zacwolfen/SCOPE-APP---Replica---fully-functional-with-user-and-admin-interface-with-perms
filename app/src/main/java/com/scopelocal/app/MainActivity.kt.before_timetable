@Composable
fun PortalTopBar(
    title: String,
    onBack: (() -> Unit)? = null,
    onMenu: (() -> Unit)? = null,
    onLongPressTitle: (() -> Unit)? = null
) {
    Row(
        Modifier
            .fillMaxWidth()
            .height(64.dp)
            .background(Blue),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Box(
            Modifier
                .width(60.dp)
                .fillMaxHeight()
                .clickable(enabled = onBack != null || onMenu != null) {
                    (onBack ?: onMenu)?.invoke()
                },
            contentAlignment = Alignment.Center
        ) {
            Icon(
                if (onBack != null) Icons.Default.ArrowBack else Icons.Default.Menu,
                null,
                tint = Color.White,
                modifier = Modifier.size(28.dp)
            )
        }

        Text(
            title,
            color = Color.White,
            fontSize = 25.sp,
            fontWeight = FontWeight.Bold,
            maxLines = 1,
            overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis,
            modifier = Modifier
                .weight(1f)
                .padding(end = 8.dp)
                .pointerInput(onLongPressTitle) {
                    if (onLongPressTitle != null) {
                        detectTapGestures(
                            onLongPress = {
                                onLongPressTitle.invoke()
                            }
                        )
                    }
                }
        )

        if (onBack != null) {
            Icon(
                Icons.Default.History,
                null,
                tint = Color.White,
                modifier = Modifier
                    .padding(end = 16.dp)
                    .size(26.dp)
            )
        } else {
            Icon(
                Icons.Default.ExitToApp,
                null,
                tint = Color.White,
                modifier = Modifier
                    .padding(end = 18.dp)
                    .size(26.dp)
            )
        }
    }
}

