                        CompletionScreen()
                    }
                }

                composable("attendance") {
                    DetailShell("Attendance", { nav.popBackStack() }) {
                        AttendanceScreen(store)
                    }
                }

                composable("cumulative") {
                    DetailShell("Cumulative Attendance", { nav.popBackStack() }) {
                        CumulativeScreen(store)
