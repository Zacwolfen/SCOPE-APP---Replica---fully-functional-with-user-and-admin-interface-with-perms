@Composable
fun AttendanceEditorScreen(store: LocalStore) {
    var rows by remember { mutableStateOf(store.attendance()) }
    var editIndex by remember { mutableStateOf<Int?>(null) }

    LazyColumn(
        Modifier
            .fillMaxSize()
            .padding(horizontal = 12.dp)
    ) {
        item {
            Text(
                "Local Attendance Editor",
                color = BrightBlue,
                fontSize = 20.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(
                    start = 8.dp,
                    top = 18.dp,
                    bottom = 6.dp
                )
            )

            Text(
                "Changes are stored only on this device.",
                color = Color.Gray,
                fontSize = 13.sp,
                modifier = Modifier.padding(
                    start = 8.dp,
                    bottom = 14.dp
                )
            )
        }

        itemsIndexed(rows) { i, a ->
            Column(
                Modifier
                    .fillMaxWidth()
                    .padding(bottom = 10.dp)
                    .shadow(1.dp, RoundedCornerShape(12.dp))
                    .clip(RoundedCornerShape(12.dp))
                    .background(if (i % 2 == 0) Color.White else RowGray)
                    .padding(14.dp)
            ) {
                Text(
                    a.code,
                    color = BrightBlue,
                    fontWeight = FontWeight.Bold,
                    fontSize = 15.sp
                )

                Spacer(Modifier.height(4.dp))

                Text(
                    a.name,
                    fontSize = 15.sp,
                    lineHeight = 20.sp
                )

                Spacer(Modifier.height(8.dp))

                Row(
                    Modifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        "Present ${a.attended}/${a.conducted}",
                        fontSize = 14.sp,
                        modifier = Modifier.weight(1f)
                    )

                    Text(
                        String.format(Locale.US, "%.2f%%", a.percentage),
                        color = BrightBlue,
                        fontWeight = FontWeight.Bold,
                        fontSize = 14.sp
                    )

                    Spacer(Modifier.width(8.dp))

                    OutlinedButton(
                        onClick = { editIndex = i }
                    ) {
                        Text("EDIT")
                    }
                }
            }
        }
    }

    editIndex?.let { index ->
        AttendanceEditDialog(
            a = rows[index],
            onDismiss = { editIndex = null }
        ) { conducted, attended ->
            store.updateAttendance(index, conducted, attended)
            rows = store.attendance()
            editIndex = null
        }
    }
}

@Composable
fun PhotoEditorScreen(store: LocalStore) {
    val context = LocalContext.current
    var student by remember { mutableStateOf(store.student()) }
    var message by remember { mutableStateOf("") }

    val picker = rememberLauncherForActivityResult(
        ActivityResultContracts.GetContent()
    ) { uri ->
        if (uri != null) {
            try {
                val destination = File(context.filesDir, "profile_photo.jpg")

                context.contentResolver.openInputStream(uri)?.use { input ->
                    FileOutputStream(destination).use { output ->
                        input.copyTo(output)
                    }
                }

                store.put(
                    "photoUri",
                    Uri.fromFile(destination).toString()
                )

                student = store.student()
                message = "Profile photo updated."
            } catch (_: Exception) {
                message = "Unable to update the profile photo."
            }
        }
    }

    Column(
        Modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
            .padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            "Local Profile Photo",
            color = BrightBlue,
            fontSize = 21.sp,
            fontWeight = FontWeight.Bold
        )

        Spacer(Modifier.height(8.dp))

        Text(
            "Choose an image stored on this device.",
            color = Color.Gray,
            fontSize = 13.sp,
            textAlign = TextAlign.Center
        )

        Spacer(Modifier.height(24.dp))

        Box(
            Modifier
                .size(190.dp, 245.dp)
                .clip(RoundedCornerShape(16.dp))
                .background(BrightBlue)
                .padding(5.dp),
            contentAlignment = Alignment.Center
        ) {
            if (!student.photoUri.isNullOrBlank()) {
                val bitmap = remember(student.photoUri) {
                    try {
                        context.contentResolver
                            .openInputStream(Uri.parse(student.photoUri))
                            ?.use { BitmapFactory.decodeStream(it) }
                    } catch (_: Exception) {
                        null
                    }
                }

                if (bitmap != null) {
                    androidx.compose.foundation.Image(
                        bitmap = bitmap.asImageBitmap(),
                        contentDescription = "Profile photo",
                        contentScale = ContentScale.Crop,
                        modifier = Modifier
                            .fillMaxSize()
                            .clip(RoundedCornerShape(12.dp))
                    )
                } else {
                    Icon(
                        Icons.Default.Person,
                        contentDescription = null,
                        tint = Color.White,
                        modifier = Modifier.size(80.dp)
                    )
                }
            } else {
                Icon(
                    Icons.Default.Person,
                    contentDescription = null,
                    tint = Color.White,
                    modifier = Modifier.size(80.dp)
                )
            }
        }

        Spacer(Modifier.height(22.dp))

        Button(
            onClick = { picker.launch("image/*") }
        ) {
            Icon(
                Icons.Default.Photo,
                contentDescription = null
            )

            Spacer(Modifier.width(8.dp))

            Text("Choose Photo")
        }

        if (message.isNotBlank()) {
            Spacer(Modifier.height(12.dp))
            Text(
                message,
                color = BrightBlue,
                fontSize = 14.sp
            )
        }
    }
}

