                }

                composable("hour") {
                    DetailShell("Hour Attendance", { nav.popBackStack() }) {
                        HourAttendanceScreen()
                    }
                }

                composable("internal") {
                    DetailShell("Internal Marks", { nav.popBackStack() }) {
                        InternalMarksScreen(store)
                    }
                }

                composable("exam") {
                    DetailShell("Exam Details", { nav.popBackStack() }) {
                        ExamDetailsScreen(store)
                    }
