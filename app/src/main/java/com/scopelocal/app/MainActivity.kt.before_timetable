@Composable
fun buildAnnotatedCodeName(code: String, name: String) = androidx.compose.ui.text.buildAnnotatedString {
    androidx.compose.ui.text.SpanStyle(color = BrightBlue).let { style -> pushStyle(style); append(code); pop() }
    append(" - $name")
}

